    {"why": "a hash on another page", "base": "https://portal.example.test/", "href": "/news#top", "attrs": {}, "expect": true},
    {"why": "a hash on the same path with another query", "base": "https://portal.example.test/reader?id=5", "href": "/reader?id=6#ch2", "attrs": {}, "expect": true},
    {"why": "another origin", "base": "https://portal.example.test/", "href": "https://other.example.test/news", "attrs": {}, "expect": false},
    {"why": "another port is another origin", "base": "https://portal.example.test/", "href": "https://portal.example.test:8443/news", "attrs": {}, "expect": false},
    {"why": "another scheme is another origin", "base": "https://portal.example.test/", "href": "http://portal.example.test/news", "attrs": {}, "expect": false},
    {"why": "a mailto link", "base": "https://portal.example.test/", "href": "mailto:a@example.test", "attrs": {}, "expect": false},
    {"why": "a javascript: URL", "base": "https://portal.example.test/", "href": "javascript:void(0)", "attrs": {}, "expect": false},
    {"why": "no href", "base": "https://portal.example.test/", "href": "", "attrs": {}, "expect": false},
    {"why": "target=_blank", "base": "https://portal.example.test/", "href": "/news", "attrs": {"target": "_blank"}, "expect": false},
