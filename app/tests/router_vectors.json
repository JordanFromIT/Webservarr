     "expect": {"action": "hard", "url": "https://portal.example.test/news"}},
    {"why": "no content type is not a page", "requested": "https://portal.example.test/news",
     "response": {"ok": true, "status": 200, "finalUrl": "https://portal.example.test/news", "redirected": false, "contentType": "", "hasModule": false},
     "expect": {"action": "hard", "url": "https://portal.example.test/news"}},
    {"why": "a server error keeps the current page", "requested": "https://portal.example.test/news",
     "response": {"ok": false, "status": 500, "finalUrl": "https://portal.example.test/news", "redirected": false, "contentType": "text/html", "hasModule": false},
     "expect": {"action": "stay", "reason": "server"}},
    {"why": "unavailable keeps the current page", "requested": "https://portal.example.test/news",
     "response": {"ok": false, "status": 503, "finalUrl": "https://portal.example.test/news", "redirected": false, "contentType": "application/json", "hasModule": false},
     "expect": {"action": "stay", "reason": "server"}},
    {"why": "a network error keeps the current page", "requested": "https://portal.example.test/news",
     "response": null,
     "expect": {"action": "stay", "reason": "network"}},
    {"why": "a not-found page without a module loads in full", "requested": "https://portal.example.test/nope",
     "response": {"ok": false, "status": 404, "finalUrl": "https://portal.example.test/nope", "redirected": false, "contentType": "text/html", "hasModule": false},
     "expect": {"action": "hard", "url": "https://portal.example.test/nope"}},
    {"why": "forbidden JSON loads in full so the browser shows it", "requested": "https://portal.example.test/tickets",
     "response": {"ok": false, "status": 403, "finalUrl": "https://portal.example.test/tickets", "redirected": false, "contentType": "application/json", "hasModule": false},
     "expect": {"action": "hard", "url": "https://portal.example.test/tickets"}}
