     "expect": {"action": "swap"}},
    {"why": "a redirect to another origin", "requested": "https://portal.example.test/news",
     "response": {"ok": true, "status": 200, "finalUrl": "https://sso.example.test/authorize", "redirected": true, "contentType": "text/html", "hasModule": false},
     "expect": {"action": "hard", "url": "https://sso.example.test/authorize"}},
    {"why": "a redirect keeps the link's hash, as the browser would", "requested": "https://portal.example.test/settings#sign-in",
     "response": {"ok": true, "status": 200, "finalUrl": "https://portal.example.test/login", "redirected": true, "contentType": "text/html", "hasModule": false},
     "expect": {"action": "hard", "url": "https://portal.example.test/login#sign-in"}},
    {"why": "JSON is not a page", "requested": "https://portal.example.test/news",
