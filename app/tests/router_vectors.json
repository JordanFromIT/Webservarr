    {"why": "a page with a query", "base": "https://portal.example.test/ebooks", "href": "/reader?id=5", "attrs": {}, "expect": true},
    {"why": "an absolute same-origin URL", "base": "https://portal.example.test/", "href": "https://portal.example.test/calendar", "attrs": {}, "expect": true},
