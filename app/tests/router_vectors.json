     "expect": {"action": "hard", "url": "https://portal.example.test/login"}},
    {"why": "a non-admin sent from Settings to Home", "requested": "https://portal.example.test/settings",
     "response": {"ok": true, "status": 200, "finalUrl": "https://portal.example.test/", "redirected": true, "contentType": "text/html", "hasModule": true},
     "expect": {"action": "hard", "url": "https://portal.example.test/"}},
    {"why": "a redirect that only changes the query is a redirect", "requested": "https://portal.example.test/reader?id=5",
