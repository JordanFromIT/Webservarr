    {"why": "a static file", "base": "https://portal.example.test/", "href": "/static/a.png", "attrs": {}, "expect": false},
    {"why": "an upload", "base": "https://portal.example.test/", "href": "/uploads/a.png", "attrs": {}, "expect": false},
