# Web Framework
#
# The previous surgical approach -- move only fastapi and starlette, leave the
# rest -- was the right call when one CVE was outstanding. It stopped being the
# right call at 64 open advisories across a dozen packages, several of them
# high and one critical, so this is a deliberate full re-resolve instead.
#
# What made it safe enough to attempt: the app imports nothing from starlette
# directly (it is purely transitive through fastapi), touches authlib through a
# single symbol, and uses only the long-stable core of fastapi -- APIRouter,
# Depends, HTTPException, Request, Response, status, Query, File, Form,
# UploadFile, Cookie. None of that surface changed across these versions.
#
# fastapi 0.141 declares `starlette>=0.46.0` with no upper bound, which is what
# allows starlette to reach 1.x and clear its advisories at all.
fastapi==0.141.1
uvicorn[standard]==0.27.0
# Pinned directly rather than left transitive: the advisories are against
# starlette itself, so the floor has to be stated where it can be seen.
starlette>=1.3.1
python-multipart==0.0.32  # <0.0.30 carries a chain of parser advisories

# OIDC Authentication
authlib==1.8.0  # 1.3.1 -> 1.8.0 clears a critical plus four highs
httpx==0.26.0
itsdangerous==2.1.2

# Database
sqlalchemy==2.0.25
aiosqlite==0.19.0

# Redis
redis==5.0.1
hiredis==2.3.2

# Security
# python-jose removed: it was never imported anywhere in the app and carried
# CVE-2024-33663 / CVE-2024-33664 (plus vulnerable ecdsa/rsa/pyasn1 transitives).
passlib[bcrypt]==1.7.4
bcrypt==4.0.1

# Rate Limiting
slowapi==0.1.9

# Utilities
python-dotenv==1.2.2
# fastapi 0.141 requires pydantic>=2.9. Both stay within pydantic v2, whose
# BaseModel/BaseSettings surface is what the app uses and has not changed.
pydantic>=2.9.0
pydantic-settings>=2.5.0

# Markdown rendering (for news posts)
markdown==3.8.1
bleach==6.4.0

